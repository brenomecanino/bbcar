<Window x:Class="AutoOrcamento.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:entities="clr-namespace:AutoOrcamento.Core.Entities;assembly=AutoOrcamento.Core" Title="Auto Orçamento" Height="760" Width="1180" WindowStartupLocation="CenterScreen">
<Grid Margin="18"><TabControl SelectedIndex="{Binding AbaSelecionada}">
<TabItem Header="Orçamentos"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><Button Content="+ Novo Orçamento" Command="{Binding NovoCommand}" Padding="18,8" Margin="0,0,8,0"/><Button Content="Clientes" Padding="18,8" Click="Clientes_Click"/><TextBox Width="260" Margin="20,0,5,0" Text="{Binding Filtro,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Filtrar" Command="{Binding CarregarCommand}"/></StackPanel><DataGrid ItemsSource="{Binding Orcamentos}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Placa" Binding="{Binding Placa}"/><DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/><DataGridTextColumn Header="Contato" Binding="{Binding Contato}"/><DataGridTextColumn Header="Data" Binding="{Binding Data,StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Valor Total" Binding="{Binding ValorTotal,StringFormat=C}"/><DataGridTextColumn Header="Status" Binding="{Binding Status}"/><DataGridTemplateColumn Header="Ações"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Editar" Command="{Binding DataContext.EditarCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="Imprimir" Margin="5,0" Command="{Binding DataContext.ImprimirCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="Novo / Editar Orçamento"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="300"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Label Content="Placa:"/><TextBox Width="140" Text="{Binding PlacaBusca}"/><Button Content="Buscar" Command="{Binding BuscarClienteCommand}" Margin="5,0"/><TextBlock Margin="15,7" Text="{Binding ClienteSelecionado.Nome}"/><Label Content="Status:"/><ComboBox Width="120" SelectedItem="{Binding Status}" ItemsSource="{Binding Source={StaticResource StatusValues}}"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14"><TextBox Width="400" MaxLength="200" Text="{Binding Descricao}"/><TextBox Width="80" Margin="5,0" Text="{Binding Quantidade}"/><TextBox Width="110" Text="{Binding ValorUnitario}"/><TextBox Width="110" Margin="5,0" Text="{Binding DescontoUnitario}"/><Button Content="+" Width="45" Command="{Binding AdicionarItemCommand}"/></StackPanel><DataGrid Grid.Row="2" ItemsSource="{Binding Itens}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/><DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}"/><DataGridTextColumn Header="Vlr Unit" Binding="{Binding ValorUnitario,StringFormat=C}"/><DataGridTextColumn Header="Desc Unit" Binding="{Binding DescontoUnitario,StringFormat=C}"/><DataGridTemplateColumn Header=""><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="✕" Command="{Binding DataContext.RemoverItemCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12"><TextBlock Text="{Binding Totais.TotalSemDesconto,StringFormat=Total sem desconto: {0:C}}"/><TextBlock FontWeight="Bold" Text="{Binding Totais.TotalComDesconto,StringFormat=Total com desconto: {0:C}}"/><TextBlock Text="{Binding Totais.TotalDesconto,StringFormat=Desconto: {0:C}}"/></StackPanel><StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Salvar" Command="{Binding SalvarCommand}" Padding="20,8"/><Button Content="Imprimir" Command="{Binding ImprimirCommand}" Padding="20,8" Margin="8,0"/></StackPanel></Grid></TabItem>
<TabItem Header="Clientes"><StackPanel Margin="10"><TextBlock FontSize="18" FontWeight="Bold" Text="Cadastro de cliente e veículo"/><UniformGrid Columns="2" Margin="0,12"><TextBox x:Name="Nome"/><TextBox x:Name="Placa"/><TextBox x:Name="Modelo"/><TextBox x:Name="Ano"/><TextBox x:Name="Telefone"/><TextBox x:Name="Cpf"/></UniformGrid><TextBlock Text="Campos: nome, placa, modelo, ano, telefone e CPF" Foreground="Gray"/><Button Content="Cadastrar e vincular ao orçamento" Padding="15,8" HorizontalAlignment="Left" Margin="0,12" Click="Cadastrar_Click"/></StackPanel></TabItem>
</TabControl></Grid></Window>