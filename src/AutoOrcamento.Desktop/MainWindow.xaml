<Window x:Name="Auto_Orçamento" x:Class="AutoOrcamento.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Orçamento" Height="760" Width="1180" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="False">
    <Window.Resources>
        <!-- Preserve uppercase behavior for text inputs -->
        <Style TargetType="TextBox">
            <Setter Property="CharacterCasing" Value="Upper"/>
        </Style>
        <Style x:Key="UpperTextBox" TargetType="TextBox">
            <Setter Property="CharacterCasing" Value="Upper"/>
        </Style>
        <!-- Status badge uses app palette -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource MutedTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pendente"><Setter Property="Background" Value="{StaticResource AccentBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Aprovado"><Setter Property="Background" Value="#FF16A34A"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Recusado"><Setter Property="Background" Value="#FFDC2626"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" MouseDown="TitleBar_MouseDown">
            <DockPanel LastChildFill="False" Margin="8,0">
                <TextBlock Text="Auto Orçamento" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="16"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Click="Minimize_Click" Style="{StaticResource TitleBarButton}" Margin="4,6">
                        <TextBlock Text="—" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="Maximize_Click" Style="{StaticResource TitleBarButton}" Margin="4,6">
                        <TextBlock Text="▢" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="Close_Click" Style="{StaticResource TitleBarButton}" Margin="4,6">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <TabControl SelectedIndex="{Binding AbaSelecionada}">
                <!-- Tab 0: Orçamentos -->
                <TabItem Header="Orçamentos">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="+ Novo Orçamento" Command="{Binding NovoCommand}" Padding="18,8" Margin="0,0,8,0"/>
                                <Button Content="Clientes" Padding="18,8" Click="Clientes_Click"/>
                                <TextBox Style="{StaticResource UpperTextBox}" Width="260" Margin="20,0,5,0" Text="{Binding Filtro,UpdateSourceTrigger=PropertyChanged}" ToolTip="Placa, nome ou contato"/>
                                <Button Content="Filtrar" Command="{Binding CarregarCommand}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Label Content="Data inicial:"/><DatePicker SelectedDate="{Binding DataInicial}"/>
                                <Label Content="Data final:" Margin="12,0,0,0"/><DatePicker SelectedDate="{Binding DataFinal}"/>
                                <Button Content="Aplicar filtro" Command="{Binding CarregarCommand}" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <DataGrid DockPanel.Dock="Top" Height="420" ItemsSource="{Binding Orcamentos}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <!-- Colunas com larguras mais equilibradas para evitar que 'Cliente' ocupe todo o espaço -->
                                <DataGridTextColumn Header="Nº" Binding="{Binding Numero, StringFormat={}{0:D5}}" Width="80" />
                                <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="110" />
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="220" />
                                <DataGridTextColumn Header="Contato" Binding="{Binding Contato}" Width="170" />
                                <DataGridTextColumn Header="Data" Binding="{Binding Data,StringFormat=dd/MM/yyyy}" Width="110" />
                                <DataGridTextColumn Header="Valor Total" Binding="{Binding ValorTotal,StringFormat=C}" Width="140" />
                                <DataGridTemplateColumn Header="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusBadge}">
                                                <TextBlock Text="{Binding Status}" Foreground="White"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Ações" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Editar" Command="{Binding DataContext.EditarCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button Content="Imprimir" Margin="5,0" Command="{Binding DataContext.ImprimirCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="&lt; Anterior" Command="{Binding PaginaAnteriorCommand}" IsEnabled="{Binding PodePaginaAnterior}" Padding="8,3" FontSize="12" Margin="2,0"/>
                            <TextBlock Text="{Binding PaginaAtual, StringFormat=Página {0}}" VerticalAlignment="Center" Margin="8,0" FontSize="12"/>
                            <TextBlock Text="de" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Text="{Binding TotalPaginas}" VerticalAlignment="Center" Margin="4,0,8,0" FontSize="12"/>
                            <Button Content="Próxima &gt;" Command="{Binding ProximaPaginaCommand}" IsEnabled="{Binding PodeProximaPagina}" Padding="8,3" FontSize="12" Margin="2,0"/>
                        </StackPanel>
                    </DockPanel>
                </TabItem>

                <!-- Tab 1: Novo / Editar Orçamento -->
                <TabItem Header="Novo / Editar Orçamento">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="300"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Label Content="Placa:"/>
                            <TextBox Style="{StaticResource UpperTextBox}" Width="140" Text="{Binding PlacaBusca}"/>
                            <Button Content="Buscar" Command="{Binding BuscarClienteCommand}" Margin="5,0"/>
                            <Button Content="Trocar" Command="{Binding TrocarClienteCommand}"/>
                            <TextBlock Margin="15,7" Text="{Binding ClienteDescricao}"/>
                            <Label Content="Status:"/>
                            <ComboBox Width="120" SelectedItem="{Binding Status}" ItemsSource="{Binding StatusDisponiveis}"/>
                        </StackPanel>

                        <!-- Campos de item com labels e validação -->
                        <Grid Grid.Row="1" Margin="0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <!-- reduzir largura da descrição para acomodar o botão + -->
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: inputs -->
                            <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Content="Descrição:"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource WatermarkedTextBox}" CharacterCasing="Upper" x:Name="DescricaoItem" MaxLength="200" Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" ToolTip="Descrição" Tag="Ex.: Troca de óleo"/>

                            <Label Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Content="Quantidade:" Margin="8,0,0,0"/>
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="QuantidadeBox" Margin="4,0" Style="{StaticResource WatermarkedTextBox}" Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" ToolTip="Quantidade" Tag="Ex.: 1" PreviewTextInput="Quantidade_PreviewTextInput" DataObject.Pasting="Quantidade_Pasting" TextChanged="Quantidade_TextChanged"/>

                            <Label Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Content="Vlr Unit:" Margin="8,0,0,0"/>
                            <TextBox Grid.Row="0" Grid.Column="5" x:Name="ValorUnitarioBox" Style="{StaticResource WatermarkedTextBox}" MaxLength="5" Text="{Binding ValorUnitario, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" ToolTip="Valor unitário" Tag="Ex.: 10000" PreviewTextInput="DigitsOnly_PreviewTextInput" DataObject.Pasting="DigitsOnly_Pasting" TextChanged="MoneyDigits_TextChanged"/>

                            <Label Grid.Row="0" Grid.Column="6" VerticalAlignment="Center" Content="Desconto:" Margin="8,0,0,0"/>
                            <TextBox Grid.Row="0" Grid.Column="7" x:Name="DescontoUnitarioBox" Style="{StaticResource WatermarkedTextBox}" MaxLength="5" Text="{Binding DescontoUnitario, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" ToolTip="Desconto unitário" Tag="Ex.: 1000" PreviewTextInput="DigitsOnly_PreviewTextInput" DataObject.Pasting="DigitsOnly_Pasting" TextChanged="MoneyDigits_TextChanged"/>

                            <Button Grid.Row="0" Grid.Column="8" Content="+" Width="45" Command="{Binding AdicionarItemCommand}" Click="AdicionarItem_Click" Margin="8,0,0,0"/>

                            <!-- Row 1: inline validation messages -->
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="QuantidadeError" Foreground="Tomato" FontSize="12" Visibility="Collapsed" Text="Quantidade inválida"/>
                            <TextBlock Grid.Row="1" Grid.Column="5" x:Name="ValorError" Foreground="Tomato" FontSize="12" Visibility="Collapsed" Text="Valor inválido"/>
                            <TextBlock Grid.Row="1" Grid.Column="7" x:Name="DescontoError" Foreground="Tomato" FontSize="12" Visibility="Collapsed" Text="Desconto inválido"/>
                        </Grid>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding Itens}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao,UpdateSourceTrigger=PropertyChanged}" Width="320"/>
                                <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade,UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                <DataGridTextColumn Header="Vlr Unit" Binding="{Binding ValorUnitario,UpdateSourceTrigger=PropertyChanged,StringFormat=C}" Width="120"/>
                                <DataGridTextColumn Header="Desc Unit" Binding="{Binding DescontoUnitario,UpdateSourceTrigger=PropertyChanged,StringFormat=C}" Width="120"/>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal,StringFormat=C}" Width="120" IsReadOnly="True"/>
                                <DataGridTemplateColumn Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remover" Command="{Binding DataContext.RemoverItemCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
                            <TextBlock Text="Sem desconto:" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Text="{Binding Totais.TotalSemDesconto,StringFormat=C}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Desconto:" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Text="{Binding Totais.TotalDesconto,StringFormat=C}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Total:" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Text="{Binding Totais.TotalComDesconto,StringFormat=C}" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Salvar" Command="{Binding SalvarCommand}"/>
                            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Margin="8,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Clientes -->
                <TabItem Header="Clientes">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                            <Button Content="Novo Cliente" Click="NovoCliente_Click"/>
                            <Button Content="Editar" Margin="8,0" Click="EditarCliente_Click"/>
                            <Button Content="Atualizar lista" Command="{Binding CarregarCommand}" Margin="8,0"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Clientes}" AutoGenerateColumns="False" IsReadOnly="True" SelectedItem="{Binding ClienteSelecionado}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="260"/>
                                <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="120"/>
                                <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="140"/>
                                <DataGridTextColumn Header="Ano" Binding="{Binding Ano}" Width="80"/>
                                <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="170"/>
                                <DataGridTextColumn Header="CPF" Binding="{Binding Cpf}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>
