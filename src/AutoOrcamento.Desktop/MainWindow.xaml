<Window x:Name="Auto_Orçamento" x:Class="AutoOrcamento.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Orçamento" Height="760" Width="1180" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="CharacterCasing" Value="Upper"/></Style>
        <Style x:Key="UpperTextBox" TargetType="TextBox"><Setter Property="CharacterCasing" Value="Upper"/></Style>
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/><Setter Property="CornerRadius" Value="8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pendente"><Setter Property="Background" Value="#FFFFC107"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Aprovado"><Setter Property="Background" Value="#FF4CAF50"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Recusado"><Setter Property="Background" Value="#FFF44336"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="18"><TabControl SelectedIndex="{Binding AbaSelecionada}">
        <TabItem Header="Orçamentos"><DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Button Content="+ Novo Orçamento" Command="{Binding NovoCommand}" Padding="18,8" Margin="0,0,8,0"/>
                    <Button Content="Clientes" Padding="18,8" Click="Clientes_Click"/>
                    <TextBox Style="{StaticResource UpperTextBox}" Width="260" Margin="20,0,5,0" Text="{Binding Filtro,UpdateSourceTrigger=PropertyChanged}" ToolTip="Placa, nome ou contato"/>
                    <Button Content="Filtrar" Command="{Binding CarregarCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Label Content="Data inicial:"/><DatePicker SelectedDate="{Binding DataInicial}"/>
                    <Label Content="Data final:" Margin="12,0,0,0"/><DatePicker SelectedDate="{Binding DataFinal}"/>
                    <Button Content="Aplicar filtro" Command="{Binding CarregarCommand}" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Orcamentos}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True"><DataGrid.Columns>
                <DataGridTextColumn Header="Placa" Binding="{Binding Placa}"/><DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                <DataGridTextColumn Header="Contato" Binding="{Binding Contato}"/><DataGridTextColumn Header="Data" Binding="{Binding Data,StringFormat=dd/MM/yyyy}"/>
                <DataGridTextColumn Header="Valor Total" Binding="{Binding ValorTotal,StringFormat=C}"/>
                <DataGridTemplateColumn Header="Status"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StatusBadge}"><TextBlock Text="{Binding Status}" Foreground="White"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ações"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Editar" Command="{Binding DataContext.EditarCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="Imprimir" Margin="5,0" Command="{Binding DataContext.ImprimirCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns></DataGrid>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="&lt; Anterior" Command="{Binding PaginaAnteriorCommand}" IsEnabled="{Binding PodePaginaAnterior}" Margin="4,0"/>
                <TextBlock Text="{Binding PaginaAtual, StringFormat=Página {0}}" VerticalAlignment="Center" Margin="10,0"/>
                <TextBlock Text="de" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalPaginas}" VerticalAlignment="Center" Margin="5,0,10,0"/>
                <Button Content="Próxima &gt;" Command="{Binding ProximaPaginaCommand}" IsEnabled="{Binding PodeProximaPagina}" Margin="4,0"/>
            </StackPanel>
        </DockPanel></TabItem>
        <TabItem Header="Novo / Editar Orçamento"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="300"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"><Label Content="Placa:"/><TextBox Style="{StaticResource UpperTextBox}" Width="140" Text="{Binding PlacaBusca}"/><Button Content="Buscar" Command="{Binding BuscarClienteCommand}" Margin="5,0"/><Button Content="Trocar" Command="{Binding TrocarClienteCommand}"/><TextBlock Margin="15,7" Text="{Binding ClienteDescricao}"/><Label Content="Status:"/><ComboBox Width="120" SelectedItem="{Binding Status}" ItemsSource="{Binding StatusDisponiveis}"/></StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14"><TextBox Style="{StaticResource UpperTextBox}" x:Name="DescricaoItem" Width="400" MaxLength="200" Text="{Binding Descricao}" ToolTip="Descrição"/><TextBox Width="80" Margin="5,0" Text="{Binding Quantidade}" ToolTip="Quantidade"/><TextBox Width="110" Text="{Binding ValorUnitario}" ToolTip="Valor unitário"/><TextBox Width="110" Margin="5,0" Text="{Binding DescontoUnitario}" ToolTip="Desconto unitário"/><Button Content="+" Width="45" Command="{Binding AdicionarItemCommand}" Click="AdicionarItem_Click"/></StackPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Itens}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"><DataGrid.Columns>
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao,UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Vlr Unit" Binding="{Binding ValorUnitario,UpdateSourceTrigger=PropertyChanged,StringFormat=C}"/><DataGridTextColumn Header="Desc Unit" Binding="{Binding DescontoUnitario,UpdateSourceTrigger=PropertyChanged,StringFormat=C}"/><DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal,StringFormat=C}" IsReadOnly="True"/>
                <DataGridTemplateColumn><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Remover" Command="{Binding DataContext.RemoverItemCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns></DataGrid>
            <StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12"><TextBlock Foreground="#FFD32F2F" Text="{Binding MensagemValidacao}" Margin="4"/><TextBlock Text="{Binding Totais.TotalSemDesconto,StringFormat=Total sem desconto: {0:C}}"/><TextBlock FontWeight="Bold" Text="{Binding Totais.TotalComDesconto,StringFormat=Total com desconto: {0:C}}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Totais.TotalDesconto,StringFormat=Desconto: {0:C} (}"/><TextBlock Text="{Binding Totais.PercentualDesconto,StringFormat=N2}"/><TextBlock Text="%)"/></StackPanel></StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Salvar" Command="{Binding SalvarCommand}" Padding="20,8"/><Button Content="Salvar como PDF" Command="{Binding SalvarComoCommand}" Padding="20,8" Margin="8,0"/><Button Content="Imprimir" Command="{Binding ImprimirCommand}" Padding="20,8"/></StackPanel>
        </Grid></TabItem>
        <TabItem Header="Clientes"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock FontSize="18" FontWeight="Bold" Text="Cadastro de cliente e veículo"/>
            <Grid Grid.Row="1" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Label Content="Nome"/><TextBox Style="{StaticResource UpperTextBox}" x:Name="Nome" Grid.Column="1" Margin="4"/><Label Grid.Column="2" Content="Placa"/><TextBox Style="{StaticResource UpperTextBox}" x:Name="Placa" Grid.Column="3" Margin="4"/>
                <Label Grid.Row="1" Content="Modelo"/><TextBox Style="{StaticResource UpperTextBox}" x:Name="Modelo" Grid.Row="1" Grid.Column="1" Margin="4"/><Label Grid.Row="1" Grid.Column="2" Content="Ano"/><TextBox x:Name="Ano" Grid.Row="1" Grid.Column="3" Margin="4"/>
                <Label Grid.Row="2" Content="Telefone"/><TextBox x:Name="Telefone" Grid.Row="2" Grid.Column="1" Margin="4"/><Label Grid.Row="2" Grid.Column="2" Content="CPF"/><TextBox x:Name="Cpf" Grid.Row="2" Grid.Column="3" Margin="4"/>
            </Grid>
            <StackPanel Grid.Row="2"><Button Content="Cadastrar e vincular ao orçamento" Padding="15,8" HorizontalAlignment="Left" Click="Cadastrar_Click"/><DataGrid ItemsSource="{Binding Clientes}" AutoGenerateColumns="False" Margin="0,12"><DataGrid.Columns><DataGridTextColumn Header="Nome" Binding="{Binding Nome,UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Placa" Binding="{Binding Placa,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Modelo" Binding="{Binding Modelo,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Ano" Binding="{Binding Ano,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Telefone" Binding="{Binding Telefone,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="CPF" Binding="{Binding Cpf,UpdateSourceTrigger=PropertyChanged}"/><DataGridTemplateColumn Header="Ações"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Salvar alterações" Command="{Binding DataContext.AtualizarClienteCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel>
        </Grid></TabItem>
    </TabControl></Grid>
</Window>
